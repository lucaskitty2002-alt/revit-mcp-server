<UserControl x:Class="revit_mcp_plugin.UI.CodexMirrorPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:revit_mcp_plugin.UI"
 Background="#F7F8FA" FontFamily="Segoe UI" Foreground="#182230"
 Loaded="Panel_Loaded" Unloaded="Panel_Unloaded" IsVisibleChanged="Panel_IsVisibleChanged" SizeChanged="Panel_SizeChanged">
 <UserControl.Resources>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#344054"/>
   <Setter Property="BorderBrush" Value="#D0D5DD"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.40"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="PanelGrid" Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="WelcomeHeader" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Codex i Revit" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="Din app. Dine chats. Alle værktøjerne." FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
   </StackPanel>
  </Grid>
  <Border x:Name="ConnectionCard" Grid.Row="1" CornerRadius="12" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" Padding="12" Margin="0,0,0,12">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="CompactLabel" Text="Codex" Visibility="Collapsed" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
    <StackPanel x:Name="PickerGroup" Margin="0,0,10,0">
     <TextBlock Text="APPVINDUE" FontSize="10" FontWeight="SemiBold" Foreground="#667085" Margin="0,0,0,5"/>
     <ComboBox x:Name="WindowPicker" MinHeight="32" BorderBrush="#D0D5DD" Background="White" FontSize="13"
      VerticalContentAlignment="Center" MaxDropDownHeight="220" SelectionChanged="WindowPicker_SelectionChanged" AutomationProperties.Name="Codex-vindue">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
    </StackPanel>
    <WrapPanel x:Name="ActionGroup" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
    <Button x:Name="RefreshButton" Content="↻" Width="36" Padding="0" FontSize="21" VerticalAlignment="Bottom"
     Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Refresh_Click" ToolTip="Find åbne Codex-vinduer" AutomationProperties.Name="Opdater vinduer"/>
    <Button x:Name="ShowButton" Content="Vis i Revit" VerticalAlignment="Bottom"
     Style="{StaticResource ActionButton}" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="Start_Click" IsEnabled="False"/>
    <Button x:Name="ReleaseButton" Content="Frigør" VerticalAlignment="Bottom"
     Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="Stop_Click" Visibility="Collapsed" ToolTip="Send Codex tilbage til skrivebordet"/>
    <Button x:Name="MoreButton" Content="⋯" FontSize="23" Width="38" Padding="0" Margin="8,0,0,0"
     Style="{StaticResource ActionButton}" Click="More_Click" ToolTip="Flere muligheder" AutomationProperties.Name="Flere muligheder">
     <Button.ContextMenu><ContextMenu>
      <MenuItem Header="Åbn Codex-appen" Click="Open_Click"/>
      <MenuItem Header="Opdater vindueslisten" Click="Refresh_Click"/>
      <Separator/>
      <MenuItem Header="Levende forhåndsvisning" Click="Preview_Click"/>
      <MenuItem Header="Gendan tidligere placering" Click="Recover_Click"/>
      <Separator/>
      <MenuItem Header="Vis teknisk info" Click="Diagnostics_Click"/>
     </ContextMenu></Button.ContextMenu>
    </Button>
    </WrapPanel>
   </Grid>
  </Border>
  <Border Grid.Row="2" x:Name="StatusBorder" Background="#EFF4FF" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#2563EB" VerticalAlignment="Top" Margin="0,5,10,0"/>
    <StackPanel Grid.Column="1">
     <TextBlock x:Name="StatusTitle" Text="Klar til at finde Codex" FontSize="12" FontWeight="SemiBold"/>
     <TextBlock x:Name="StatusText" Text="Åbn Codex-appen, og vælg vinduet ovenfor." FontSize="12" TextWrapping="Wrap" Foreground="#475467" Margin="0,3,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="3" BorderBrush="#E4E7EC" BorderThickness="1" Background="White" CornerRadius="12" ClipToBounds="True">
   <Grid>
    <local:CodexMirrorSurface x:Name="Surface" MinHeight="80" Margin="8"/>
    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="350">
     <Border x:Name="EmptyGraphic" Width="56" Height="56" Background="#EFF4FF" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,16">
      <Canvas Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Rectangle Width="26" Height="22" RadiusX="4" RadiusY="4" Stroke="#2563EB" StrokeThickness="1.5" Canvas.Left="1" Canvas.Top="3"/>
       <Line X1="2" Y1="10" X2="26" Y2="10" Stroke="#2563EB" StrokeThickness="1.5"/>
       <Ellipse Width="2" Height="2" Fill="#2563EB" Canvas.Left="6" Canvas.Top="6"/>
       <Ellipse Width="2" Height="2" Fill="#2563EB" Canvas.Left="11" Canvas.Top="6"/>
      </Canvas>
     </Border>
     <TextBlock x:Name="EmptyTitle" Text="Hele Codex, samlet her" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
     <TextBlock x:Name="EmptyDescription" Text="Vælg dit åbne Codex-vindue og tryk Vis i Revit. Du bruger appens egne chats, billeder og godkendelser."
      FontSize="13" TextWrapping="Wrap" Foreground="#667085" TextAlignment="Center" Margin="0,9,0,0"/>
     <Button Content="Åbn Codex" x:Name="OpenButton" Click="Open_Click" HorizontalAlignment="Center" Margin="0,18,0,0" Style="{StaticResource ActionButton}"/>
    </StackPanel>
   </Grid>
  </Border>
  <TextBlock x:Name="Footer" Grid.Row="4" Text="Frigør sender vinduet tilbage til skrivebordet." FontSize="11" Foreground="#667085" TextAlignment="Center" Margin="0,10,0,0"/>
 </Grid>
</UserControl>
