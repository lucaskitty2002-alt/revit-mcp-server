<UserControl x:Class="revit_mcp_plugin.UI.CodexMirrorPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:revit_mcp_plugin.UI" Loaded="Panel_Loaded" Unloaded="Panel_Unloaded" IsVisibleChanged="Panel_IsVisibleChanged">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,10">
   <TextBlock Text="Hele Codex i Revit" FontSize="19" FontWeight="SemiBold"/>
   <TextBlock Text="Brug det originale appvindue med dets egne chats, godkendelser og værktøjer. Vinduet flyttes tilbage, når du frigør det." Foreground="#555" TextWrapping="Wrap" Margin="0,5,0,10"/>
   <WrapPanel>
    <Button Content="Åbn Codex" Click="Open_Click" Padding="10,5" Margin="0,0,6,6"/>
    <Button Content="Hent vinduer" Click="Refresh_Click" Padding="10,5" Margin="0,0,6,6"/>
    <Button Content="Vis Codex i Revit" Click="Start_Click" Padding="10,5" Margin="0,0,6,6"/>
    <Button Content="Tilbage til skrivebord" Click="Stop_Click" Padding="10,5" Margin="0,0,6,6"/>
    <Button Content="Gendan vindue" Click="Recover_Click" Padding="10,5" Margin="0,0,6,6"/>
    <Button Content="Kun forhåndsvisning" Click="Preview_Click" Padding="10,5" Margin="0,0,6,6"/>
   </WrapPanel>
   <ComboBox x:Name="WindowPicker" MinHeight="28" MaxDropDownHeight="200"/>
  </StackPanel>
  <local:CodexMirrorSurface x:Name="Surface" Grid.Row="1" MinHeight="180"/>
  <TextBlock x:Name="StatusText" Grid.Row="2" Text="Eksperimentel vinduesplacering · vælg vinduet og tryk Vis Codex i Revit." TextWrapping="Wrap" Foreground="#555" Margin="0,8,0,0"/>
 </Grid>
</UserControl>
