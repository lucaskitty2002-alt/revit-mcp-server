<Page x:Class="revit_mcp_plugin.UI.CodexSettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer Background="White" VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="0,0,20,20">
   <TextBlock Text="Codex · delt chat" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="Åbn en eksisterende chat i Codex-appen. Vælg derefter samme chat i Revit-panelet, og tryk Forbind chat. Beskeder og svar hentes fra appens samtale. Appen skal være åben."/>
   <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="Revit-panelet understøtter tekstbeskeder og tekstsvar. Modeller, værktøjer, godkendelser, spørgsmål og vedhæftninger håndteres i Codex-appen. Revit MCP Switch skal være aktiveret for modelværktøjer."/>
   <Button Content="Åbn Codex" Click="OpenCodex_Click" HorizontalAlignment="Left" Padding="18,8" Margin="0,20,0,12"/>
   <TextBlock x:Name="Status" Foreground="#555555" TextWrapping="Wrap"/>
   <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="Forbindelsen bruger Codex-appens interne chatdeling og er eksperimentel. En appopdatering kan kræve en opdatering af tilføjelsen. Der flyttes ikke længere vinduer, og skærmskalering påvirker ikke chatforbindelsen."/>
  </StackPanel>
 </ScrollViewer>
</Page>
