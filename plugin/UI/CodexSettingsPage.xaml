<Page x:Class="revit_mcp_plugin.UI.CodexSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
        <StackPanel Margin="0,0,20,20">
            <TextBlock Text="Codex" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Use your Codex account in the Revit chat panel." TextWrapping="Wrap" Margin="0,8,0,20"/>
            <Border Background="#F3F4F6" Padding="14" CornerRadius="6" Margin="0,0,0,20">
                <TextBlock TextWrapping="Wrap" Text="Sign in to Codex once on this computer. The panel uses that login automatically. No API key needs to be entered here. The model and account are managed by Codex."/>
            </Border>
            <TextBlock Text="Codex executable (optional)" FontWeight="SemiBold"/>
            <TextBox x:Name="ExecutablePath" Padding="8" Margin="0,6,0,8"/>
            <TextBlock Text="Leave empty to find codex.exe automatically, or select it with Browse." TextWrapping="Wrap" Foreground="#666666"/>
            <Button Content="Browse…" Click="Browse_Click" HorizontalAlignment="Left" Padding="15,7" Margin="0,8,0,20"/>
            <TextBlock Text="Model (optional)" FontWeight="SemiBold"/>
            <TextBox x:Name="ModelName" Padding="8" Margin="0,6,0,8"/>
            <TextBlock Text="Leave empty to use your configured Codex model. Start a new chat after changing these settings." TextWrapping="Wrap" Foreground="#666666"/>
            <WrapPanel Margin="0,20,0,12">
                <Button Content="Save" Click="Save_Click" Padding="18,8" Margin="0,0,8,8"/>
                <Button Content="Check login" Click="CheckLogin_Click" Padding="18,8" Margin="0,0,8,8"/>
                <Button Content="Sign in" Click="SignIn_Click" Padding="18,8" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#666666"/>
        </StackPanel>
    </ScrollViewer>
</Page>
