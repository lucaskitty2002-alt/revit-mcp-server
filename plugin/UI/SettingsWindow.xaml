<Window x:Class="revit_mcp_plugin.UI.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:revit_mcp_plugin.UI"
             mc:Ignorable="d" 
             Title="VUE Studio · Indstillinger" Height="640" Width="950" MinWidth="720" MinHeight="460"
             Background="#F8FAFC" FontFamily="Segoe UI" Foreground="#0F172A">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Selection" Padding="{TemplateBinding Padding}" CornerRadius="8" Background="Transparent">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#134E4A"/><Setter Property="Foreground" Value="#CCFBF1"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Opacity" Value="0.75"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation panel -->
        <Border Grid.Column="0" Background="#0F172A" Padding="14,26">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="12,0,0,28">
                <TextBlock Text="VUE" FontSize="30" FontWeight="Bold" Foreground="#5EEAD4"/>
                <TextBlock Text="STUDIO" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="1,3,0,0"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Lucas &amp; Rasmus · VUE&#x0a;Open source · se Om Studio" FontSize="10" Foreground="#94A3B8" Margin="12,16,0,0"/>
            <ListBox x:Name="NavListBox" BorderThickness="0" Background="Transparent" 
                     SelectionChanged="NavListBox_SelectionChanged">
                <ListBoxItem x:Name="GeneralItem" IsSelected="True" Padding="10,8">
                    <TextBlock Text="Forbindelse" FontSize="14"/>
                </ListBoxItem>
                <ListBoxItem x:Name="CodexItem" Padding="10,8">
                    <TextBlock Text="Codex" FontSize="14"/>
                </ListBoxItem>
                <ListBoxItem x:Name="CommandSetItem" Padding="10,8">
                    <TextBlock Text="Værktøjer" FontSize="14"/>
                </ListBoxItem>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Right content area -->
        <Grid Grid.Column="1" Margin="26">
            <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
