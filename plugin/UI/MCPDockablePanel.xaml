<Page x:Class="revit_mcp_plugin.UI.MCPDockablePanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:revit_mcp_plugin.UI"
      Background="White" Loaded="Page_Loaded" Unloaded="Page_Unloaded" IsVisibleChanged="Page_IsVisibleChanged">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="14,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Codex app in Revit" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Use the actual Codex desktop window, with its existing chats and tools." TextWrapping="Wrap" Foreground="#555555" Margin="0,5,0,10"/>
                <WrapPanel>
                    <Button Content="Open Codex" Click="OpenCodex_Click" Padding="12,6" Margin="0,0,6,6"/>
                    <Button x:Name="RefreshButton" Content="Refresh windows" Click="Refresh_Click" Padding="12,6" Margin="0,0,6,6"/>
                    <Button x:Name="AttachButton" Content="Show in Revit" Click="Attach_Click" Padding="12,6" Margin="0,0,6,6"/>
                    <Button Content="Release to desktop" Click="Release_Click" Padding="12,6" Margin="0,0,6,6"/>
                    <Button Content="Recover window" Click="Recover_Click" Padding="12,6" Margin="0,0,6,6"/>
                </WrapPanel>
                <ComboBox x:Name="WindowPicker" MinHeight="28" MaxDropDownHeight="240" HorizontalContentAlignment="Stretch"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <StackPanel x:Name="Instructions" VerticalAlignment="Center" Margin="24">
                <TextBlock Text="Bring your Codex window into Revit" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="1. Open Codex and sign in in the app.&#10;2. Refresh windows and select the Codex window.&#10;3. Choose Show in Revit."/>
                <TextBlock Margin="0,14,0,0" Foreground="#555555" TextWrapping="Wrap" Text="This moves the existing app window; it does not copy the screen or create another chat. Choose your chat in Codex as usual. For Revit work, enable Revit MCP Switch and use the registered revit-mcp connection."/>
                <TextBlock Margin="0,14,0,0" Foreground="#555555" TextWrapping="Wrap" Text="Release to desktop returns the app to its original position. Hiding this panel or closing Revit normally also releases it. Window embedding is experimental; some popups may remain separate desktop windows."/>
            </StackPanel>
            <local:CodexDesktopHost x:Name="DesktopHost" Visibility="Collapsed" />
        </Grid>
        <Border Grid.Row="2" Padding="12,8" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Background="#F9FAFB">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Open Codex to choose its window." TextWrapping="Wrap" Foreground="#444444"/>
                <TextBlock x:Name="RevitStatus" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#666666"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
