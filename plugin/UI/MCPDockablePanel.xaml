<Page x:Class="revit_mcp_plugin.UI.MCPDockablePanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar - minimal like Codex -->
        <Border Grid.Row="0" Background="White" Padding="14,10" BorderBrush="#EDEBE8" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Codex for Revit" Foreground="#1A1A1A" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="  ⌄" Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator" Width="7" Height="7" Margin="0,0,5,0"/>
                    <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " Foreground="#DDD" FontSize="11"/>
                    <TextBlock Text="New chat" Foreground="#202123" FontSize="11"
                               Cursor="Hand" MouseLeftButtonDown="ClearChat_Click"/>
                    <TextBlock Text="  |  " Foreground="#DDD" FontSize="11"/>
                    <TextBlock Text="Export" Foreground="#202123" FontSize="11"
                               Cursor="Hand" MouseLeftButtonDown="ExportChat_Click"/>
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Cursor="Hand" Foreground="#888" ToolTip="Verify Connection"
                               MouseDown="VerifyConnection_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Messages -->
        <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Background="White">
            <ItemsControl x:Name="ChatMessages">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding RowBackground}" Padding="20,16"
                                BorderBrush="#F0EEEB" BorderThickness="0,0,0,1">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                        Background="{Binding AvatarBackground}" Margin="0,2,14,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding AvatarLetter}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Content -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding RoleLabel}" Foreground="{Binding RoleLabelColor}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Text, Mode=OneWay}"
                                             Foreground="{Binding TextColor, Mode=OneWay}"
                                             FontSize="14" TextWrapping="Wrap"
                                             FontFamily="{Binding FontFamily, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="True"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalScrollBarVisibility="Disabled"
                                             HorizontalScrollBarVisibility="Disabled"
                                             IsTabStop="False" Padding="0" Margin="0"
                                             SelectionBrush="#202123"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Typing -->
        <Border Grid.Row="2" x:Name="TypingIndicator" Visibility="Collapsed"
                Background="#FAF9F7" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                        Background="#202123" Margin="0,0,14,0">
                    <TextBlock Text="C" Foreground="White" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="TypingText" Text="Codex is thinking..."
                           Foreground="#999" FontSize="14" FontStyle="Italic" VerticalAlignment="Center"/>
                <Border Grid.Column="2" CornerRadius="10" Padding="8,3" Margin="8,0,0,0"
                        Background="#F0EEEB" BorderBrush="#D4D1CC" BorderThickness="1"
                        Cursor="Hand" MouseLeftButtonDown="StopButton_Click">
                    <TextBlock Text="Stop" FontSize="10" Foreground="#888" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Prompt Chips - contextual suggestions -->
        <Border Grid.Row="3" x:Name="ChipsBar" Background="#FAF9F7" Padding="12,6"
                BorderBrush="#F0EEEB" BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PromptChips">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="#E3F2FD" Margin="0,0,6,4"
                                    Padding="10,5" Cursor="Hand"
                                    MouseLeftButtonDown="Chip_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#BBDEFB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#1565C0"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Input - Codex exact style -->
        <Border Grid.Row="4" Background="White" Padding="16,10,16,16">
            <Border Background="White" CornerRadius="22"
                    BorderBrush="#D4D1CC" BorderThickness="1"
                    Padding="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Drawings selected for the next message -->
                    <StackPanel Grid.Row="0">
                        <ItemsControl x:Name="AttachmentList" Margin="14,8,14,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding}" Click="RemoveAttachment_Click"
                                                AutomationProperties.Name="Remove drawing" Padding="5,1" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    <!-- Text input -->
                    <Grid Grid.Row="0">
                        <TextBox x:Name="ChatInput"
                                 Background="Transparent" Foreground="#1A1A1A" CaretBrush="#1A1A1A"
                                 BorderThickness="0" Padding="16,14,50,14" FontSize="14"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="ChatInput_KeyDown"
                                 VerticalContentAlignment="Top"
                                 FontFamily="Segoe UI"/>
                        <!-- Placeholder -->
                        <TextBlock x:Name="Placeholder" Text="Reply or attach a drawing..." IsHitTestVisible="False"
                                   Foreground="#AAA" FontSize="14" Padding="18,14,0,0"
                                   FontFamily="Segoe UI"/>
                    </Grid>
                    </StackPanel>

                    <!-- Bottom bar with send button -->
                    <Grid Grid.Row="1" Margin="8,0,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Button x:Name="AttachButton" Content="+ Attach drawing" Click="AttachDrawing_Click"
                                    HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,4"
                                    ToolTip="PNG/JPEG · up to 4 images · 10 MB each, 20 MB total. Selected drawings are sent to your Codex account when you press Send."/>
                            <TextBlock Text="Enter to send · Shift+Enter for new line" FontSize="10" Foreground="#777" Margin="6,2,0,0" TextWrapping="Wrap"/>
                            <Expander Header="Codex usage" FontSize="11" Margin="4,6,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="UsageText" Text="Usage appears after connecting with your first message." TextWrapping="Wrap" Foreground="#666" Margin="4,4,0,4"/>
                                    <Button x:Name="RefreshUsageButton" Content="Refresh usage" Click="RefreshUsage_Click" HorizontalAlignment="Left" Padding="6,2"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- Send button -->
                        <Button x:Name="SendButton" Grid.Column="1" Click="Send_Click"
                                AutomationProperties.Name="Send message" ToolTip="Send message (Enter)"
                                Background="Transparent" BorderThickness="0"
                                Padding="0" Cursor="Hand" VerticalAlignment="Top" Margin="0,3,0,0">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#202123">
                                <Path Data="M5,3L19,12L5,21Z" Fill="White"
                                      Width="9" Height="11" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                            </Border>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Page>
