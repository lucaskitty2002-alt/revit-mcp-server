<Page x:Class="revit_mcp_plugin.UI.MCPDockablePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:revit_mcp_plugin.UI" Background="#FAFAFA"
 Loaded="Page_Loaded" Unloaded="Page_Unloaded" IsVisibleChanged="Page_IsVisibleChanged">
 <TabControl BorderThickness="0" Background="#F7F8FA">
  <TabControl.Resources>
   <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="#667085"/><Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="8,6,0,5"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="TabBorder" Background="Transparent" CornerRadius="7" Padding="12,7">
      <ContentPresenter ContentSource="Header"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#EAF0FF"/><Setter Property="Foreground" Value="#1D4ED8"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Opacity" Value="0.75"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </TabControl.Resources>
  <TabItem Header="Codex-vindue"><local:CodexMirrorPanel x:Name="MirrorPanel"/></TabItem>
  <TabItem Header="Tekstchat">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Codex · delt chat" FontSize="19" FontWeight="SemiBold"/>
   <TextBlock Text="Samme samtale som i Codex-appen · eksperimentel forbindelse" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,10"/>
   <WrapPanel>
    <Button Content="Åbn Codex" Click="OpenCodex_Click" Padding="10,5" Margin="0,0,6,6"/>
    <Button x:Name="RefreshButton" Content="Hent chats" Click="Refresh_Click" Padding="10,5" Margin="0,0,6,6"/>
    <Button x:Name="ConnectButton" Content="Forbind chat" Click="Connect_Click" Padding="10,5" Margin="0,0,6,6"/>
   </WrapPanel>
   <ComboBox x:Name="ThreadPicker" DisplayMemberPath="Label" MinHeight="28" MaxDropDownHeight="240"/>
   <TextBlock x:Name="ThreadIdentity" Foreground="#666" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,8"/>
  </StackPanel>
  <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6">
   <TextBox x:Name="History" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="6" Text="Vælg en eksisterende chat, som er åben i Codex-appen, og tryk Forbind chat."/>
  </ScrollViewer>
  <StackPanel Grid.Row="2">
   <TextBlock Text="Godkendelser, spørgsmål, billeder og øvrige appfunktioner håndteres i Codex-appen." TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,6"/>
   <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" MaxHeight="180" VerticalScrollBarVisibility="Auto" Padding="10" PreviewKeyDown="Composer_KeyDown"/>
   <Button x:Name="SendButton" Content="Send · Enter" HorizontalAlignment="Right" Padding="18,7" Margin="0,6,0,6" Click="Send_Click" IsEnabled="False"/>
  </StackPanel>
  <StackPanel Grid.Row="3">
   <TextBlock x:Name="StatusText" Text="Ikke forbundet · Shift+Enter giver en ny linje." TextWrapping="Wrap" Foreground="#444"/>
   <TextBlock x:Name="RevitStatus" FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
 </Grid>
 </TabItem>
 </TabControl>
</Page>
